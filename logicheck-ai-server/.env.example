# ===== LogiCheck AI 服务端配置（复制为 .env 后按需修改）=====
# 第一阶段默认零外部密钥：SQLite 本地数据库 + 本地磁盘文件存储 + 本地邮件发件箱。

# HTTP 监听端口
PORT=4000

# 数据库文件位置（相对 server/ 目录）
DATABASE_PATH=./data/logicheck.db

# 上传文件存储根目录（相对 server/ 目录）
UPLOAD_DIR=./data/uploads

# 本地邮件发件箱目录（开发模式：找回密码邮件写入此处 .eml 文件）
MAIL_OUTBOX_DIR=./data/mail-outbox

# 会话有效期（天）
SESSION_TTL_DAYS=7

# 跨域允许的前端来源（Vite dev server）
CORS_ORIGIN=http://localhost:5173

# ===== 以下为可选的真实 SMTP 发信配置（留空则使用本地发件箱）=====
# 配置后找回密码邮件将通过 SMTP 真实发送。以 QQ 邮箱为例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=yourname@qq.com
#   SMTP_PASS=xxxxxxxx   （QQ 邮箱「设置 → 账户 → POP3/SMTP 服务」开启后获取的授权码，不是登录密码）
#   MAIL_FROM=yourname@qq.com
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
