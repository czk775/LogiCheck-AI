# ===== LogiCheck AI 服务端配置（复制为 .env 后按需修改）=====
# 第一阶段默认零外部密钥：SQLite 本地数据库 + 本地磁盘文件存储 + 本地邮件发件箱。
#
# 【重要】.env 文件已被 .gitignore 双重忽略（仓库根目录 + 服务端各一条），
#         不会被提交到 Git。请勿把密钥写入任何源码文件。

# HTTP 监听端口
PORT=4000

# 数据库文件位置（相对 server/ 目录）
DATABASE_PATH=./data/logicheck.db

# 上传文件存储根目录（相对 server/ 目录）
UPLOAD_DIR=./data/uploads

# 本地邮件发件箱目录（开发模式：找回密码邮件写入此处 .eml 文件）
MAIL_OUTBOX_DIR=./data/mail-outbox

# 会话有效期（天）
SESSION_TTL_DAYS=7

# 跨域允许的前端来源（Vite dev server）
CORS_ORIGIN=http://localhost:5173

# ================================================================
# 第五阶段：真实大模型接入（阿里云百炼 DashScope，OpenAI 兼容协议）
# ================================================================
# 使用步骤：
#   1. 在百炼控制台创建 API Key：https://bailian.console.aliyun.com/
#   2. 把 .env.example 复制为 .env（同目录）
#   3. 在 .env 里填入 DASHSCOPE_API_KEY 与 AI_MODEL（其余可留默认）
#   4. 重启后端：npm run dev
#   5. 验证连通性：npm run ai:check
#
# 密钥只写在 .env 里，绝不要贴到聊天窗口、代码或 Git 提交中。

# 提取方式：deterministic（默认，纯规则，无外部调用）/ ai（真实大模型）
# 设为 ai 后，未配置 Key 的单证会明确失败并提示原因，不会伪造识别结果。
EXTRACTION_PROVIDER=deterministic

# 阿里云百炼 API Key（必填，与 AI_MODEL 同时存在才算「已接通」）
# 获取地址：https://bailian.console.aliyun.com/ →  API-KEY 管理
DASHSCOPE_API_KEY=

# 结构化字段提取模型（必填）
#   qwen-plus      文本提取，性价比高，推荐作为默认
#   qwen3-vl-plus  视觉+文本一体（若希望同一个模型兼顾图片）
AI_MODEL=qwen-plus

# 视觉/OCR 模型（选填）
#   留空则复用 AI_MODEL。
#   图片单证与扫描件 PDF 必须有可用的视觉模型，否则会明确失败并提示。
#   可选：qwen3-vl-plus、qwen-vl-max、qwen-vl-ocr
AI_VISION_MODEL=qwen3-vl-plus

# OpenAI 兼容端点（选填，默认百炼国内地址）
#   北京：https://dashscope.aliyuncs.com/compatible-mode/v1
#   国际：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 注意：API Key 与 endpoint 必须属于同一地域，否则返回 401。
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 单次请求超时（毫秒）与失败重试次数
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# 单份单证最多送入模型的页数（超出截断，避免额度失控）
AI_MAX_PAGES=8
# 单次响应输出 token 上限（额度护栏）：提取任务几百 token 足够，4096 留足余量
AI_MAX_OUTPUT_TOKENS=4096

# ===== 以下为可选的真实 SMTP 发信配置（留空则使用本地发件箱）=====
# 配置后找回密码邮件将通过 SMTP 真实发送。以 QQ 邮箱为例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=yourname@qq.com
#   SMTP_PASS=xxxxxxxx   （QQ 邮箱「设置 → 账户 → POP3/SMTP 服务」开启后获取的授权码，不是登录密码）
#   MAIL_FROM=yourname@qq.com
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
