{
  "name": "logicheck-ai-server",
  "private": true,
  "version": "1.0.0",
  "description": "LogiCheck AI 服务端（第一阶段：认证 / 货物 / 单证 / 数据隔离；SQLite + 本地文件存储）",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.build.json && node --import tsx/esm scripts/copy-assets.ts",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx/esm --test test/*.test.ts",
    "migrate": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx/esm src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.3.3",
    "nodemailer": "^6.10.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
